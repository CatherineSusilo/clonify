generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  REAL_ESTATE
  DISASTER_RELIEF
  ACCESSIBILITY_AUDIT
  MEP_ENGINEER
}

enum UnitPreference {
  IMPERIAL
  METRIC
}

enum ScanStatus {
  processing
  ready
  error
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  role           Role?
  unitPreference UnitPreference @default(IMPERIAL)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  scans          Scan[]
  sessions       Session[]
  subscription   Subscription?
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Scan {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id])
  role              Role
  placeTitle        String? // e.g. "CN Tower" — used to search Wikimedia Commons/Openverse for reconstruction images
  street            String
  city              String
  state             String
  country           String
  lat               Float?
  lng               Float?
  metadata          String // JSON string of role-specific fields
  photoKeys         String // JSON string array of S3 object keys
  panoramaKey       String? // S3 object key for an optional equirectangular (360°) photo, preferred as the reconstruction source
  referenceImages   String     @default("[]") // JSON array of {url,title,license,attribution,source} found by searching placeTitle online
  status            ScanStatus @default(processing)
  modelUrl          String?
  isPublicBuilding  Boolean    @default(false)
  blueprintSource   String? // JSON: { provider, attribution, license, footprint, tags } from public open data
  rooms             Room[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Room {
  id           String   @id @default(cuid())
  scanId       String
  scan         Scan     @relation(fields: [scanId], references: [id])
  name         String
  category     String?
  photoKeys    String   @default("[]") // JSON string array of S3 object keys
  panoramaKey  String? // S3 object key for an equirectangular (360°) photo
  connections  String   @default("[]") // JSON string array of adjacent Room ids, for room-to-room navigation
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id])
  isPro                Boolean  @default(false)
  plan                 String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  updatedAt            DateTime @updatedAt
}

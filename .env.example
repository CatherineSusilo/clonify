# SQLite for local/dev. Point at Postgres in production if you prefer.
DATABASE_URL="file:./dev.db"

# Public origin used in Stripe redirects and Nominatim User-Agent
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MinIO from docker-compose.yml (S3-compatible). Optional — uploads fall back locally.
S3_REGION="us-east-1"
S3_ENDPOINT="http://127.0.0.1:9000"
S3_ACCESS_KEY_ID="s3_access_key"
S3_SECRET_ACCESS_KEY="s3_secret_key_change_me"
S3_BUCKET_NAME="clonify"

# Valkey/Redis from docker-compose.yml. Optional — reconstruction runs in-process without it.
REDIS_URL="redis://127.0.0.1:6379"

# Stripe test keys. Leave unset to skip paid checkout.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional override for the TRELLIS Hugging Face Space
# TRELLIS_SPACE_URL="https://trellis-community-trellis.hf.space"

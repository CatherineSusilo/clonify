DATABASE_URL="file:./dev.db"

# Object storage — MinIO (self-hosted, S3-API compatible). Start with:
#   docker compose up -d minio
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="s3_access_key"
S3_SECRET_ACCESS_KEY="s3_secret_key_change_me"
S3_REGION="us-east-1"
S3_BUCKET_NAME="clonify-scans-dev"

# Queue — BullMQ on Valkey (self-hosted, Redis-protocol compatible). Start with:
#   docker compose up -d valkey
REDIS_URL="redis://localhost:6379"

# Stripe — put a REAL test-mode secret key here to exercise checkout end-to-end
STRIPE_SECRET_KEY="sk_test_FAKE00000000000000000000000000"
STRIPE_WEBHOOK_SECRET="whsec_FAKE00000000000000000000000000"

# TRELLIS (Microsoft) mesh reconstruction — calls a free, public, keyless
# Hugging Face Space (trellis-community/TRELLIS) since this app has no
# 12GB+ VRAM GPU to run TRELLIS itself. Community-run and can be slow or
# unavailable; override if you stand up your own Space or GPU-backed mirror.
TRELLIS_SPACE_URL="https://trellis-community-trellis.hf.space"

# Indoor positioning: OpenHPS (open source, Apache-2.0, @openhps/core) — runs
# locally, no API keys or accounts needed. See lib/positioning.ts.

NEXT_PUBLIC_APP_URL="http://localhost:3100"

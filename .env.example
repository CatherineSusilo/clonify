# SQLite for local/dev. Point at Postgres in production if you prefer.
DATABASE_URL="file:./dev.db"

# Public origin used in Stripe redirects and Nominatim User-Agent
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MinIO from docker-compose.yml (S3-compatible). Optional — uploads fall back locally.
S3_REGION="us-east-1"
S3_ENDPOINT="http://127.0.0.1:9000"
S3_ACCESS_KEY_ID="s3_access_key"
S3_SECRET_ACCESS_KEY="s3_secret_key_change_me"
S3_BUCKET_NAME="clonify"

# Valkey/Redis from docker-compose.yml. Optional — reconstruction runs in-process without it.
REDIS_URL="redis://127.0.0.1:6379"

# Stripe test keys. Leave unset to skip paid checkout.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# App-managed local MapAnything service. Next.js starts this Python worker
# automatically during Node startup; the model itself remains lazy-loaded.
# Install MapAnything in the Python environment used by MAP_ANYTHING_PYTHON.
# MAP_ANYTHING_PYTHON="python3"
# MAP_ANYTHING_APP_DIR="services/mapanything"
# MAP_ANYTHING_URL="http://127.0.0.1:8787"
# MAP_ANYTHING_AUTO_START="true"
# Conservative defaults use only 4 views per scan.
# MAP_ANYTHING_MAX_VIEWS="4"
# CPU inference can take several minutes on a laptop; default is 15 minutes.
# MAP_ANYTHING_TIMEOUT_MS="900000"
